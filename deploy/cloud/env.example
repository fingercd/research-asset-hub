# Public DNS names. Both records must resolve to this server before deployment.
HUB_DOMAIN=research.example.com
HUB_ASSET_DOMAIN=assets.research.example.com
HUB_COOKIE_DOMAIN=.research.example.com
HUB_ACME_EMAIL=operator@example.com

# Generic OIDC discovery values. The client secret is a file, not an env value.
HUB_OIDC_ISSUER_URL=https://identity.example.com/realms/research
HUB_OIDC_CLIENT_ID=research-asset-hub

# Immutable application image and read-only host asset root.
HUB_APP_IMAGE=registry.example.com/research-asset-hub:v1
HUB_PRIVATE_ASSET_ROOT=/srv/research-assets

# Directory containing the six required secret files documented in secrets/README.md.
HUB_SECRET_DIR=./secrets

# Optional port and isolated network overrides.
HUB_HTTP_PORT=80
HUB_HTTPS_PORT=443
HUB_EDGE_SUBNET=172.30.0.0/24
HUB_CADDY_EDGE_IP=172.30.0.10
