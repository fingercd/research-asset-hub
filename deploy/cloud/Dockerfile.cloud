FROM node:22.17.0-bookworm-slim AS web-build

WORKDIR /src
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
RUN pnpm build


FROM python:3.12.11-slim-bookworm AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --home-dir /var/lib/research-asset-hub \
        --shell /usr/sbin/nologin --uid 10001 hub

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY apps apps
COPY config config
COPY migrations migrations
COPY packages packages
COPY deploy/cloud deploy/cloud
COPY --from=web-build /src/apps/web/dist apps/web/dist

RUN python -m venv /app/.venv \
    && /app/.venv/bin/pip install --no-cache-dir --upgrade pip \
    && /app/.venv/bin/pip install --no-cache-dir . \
    && chmod 0555 /app/deploy/cloud/bin/run_hub.py \
    && mkdir -p /app/outputs /var/lib/research-asset-hub \
    && chown -R hub:hub /app /var/lib/research-asset-hub

USER hub
ENTRYPOINT ["python", "/app/deploy/cloud/bin/run_hub.py"]
