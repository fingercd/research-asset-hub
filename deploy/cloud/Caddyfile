{
	email {$HUB_ACME_EMAIL}
	admin off
}

(edge_security) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	}
	encode zstd gzip
}

(oidc_gate) {
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Email

			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}

		reverse_proxy hub:8765 {
			# The current application deliberately trusts only its local Host.
			# Caddy remains the sole public listener and preserves the external
			# host in X-Forwarded-Host.
			header_up Host 127.0.0.1
		}
	}
}

{$HUB_DOMAIN} {
	import edge_security

	@edge_health path /edge-healthz
	respond @edge_health "ok" 200

	import oidc_gate
}

{$HUB_ASSET_DOMAIN} {
	import edge_security

	@edge_health path /edge-healthz
	respond @edge_health "ok" 200

	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}

			@unauthorized status 401
			handle_response @unauthorized {
				redir * https://{$HUB_DOMAIN}/oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}

		reverse_proxy hub:8766 {
			header_up Host 127.0.0.1
		}
	}
}
