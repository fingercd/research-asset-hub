{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-asset-hub:private-storage:v1alpha1",
  "title": "Research Asset Hub private asset storage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "spec"],
  "properties": {
    "apiVersion": {
      "const": "research-asset-hub/v1alpha1"
    },
    "kind": {
      "const": "PrivateAssetStorage"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "readOnly", "capabilities"],
      "properties": {
        "driver": {
          "enum": ["filesystem", "s3-compatible"]
        },
        "readOnly": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["stat", "range-read", "list", "checksum"]
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["containerPath"],
          "properties": {
            "containerPath": {
              "const": "/srv/research-assets"
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string"
            },
            "credentialFile": {
              "const": "/run/secrets/private_storage_credentials"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "const": "filesystem"
              }
            }
          },
          "then": {
            "required": ["filesystem"]
          }
        },
        {
          "if": {
            "properties": {
              "driver": {
                "const": "s3-compatible"
              }
            }
          },
          "then": {
            "required": ["s3"]
          }
        }
      ]
    }
  }
}
