{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchAssetHub",
  "version": "0.3.0-rc.1",
  "identifier": "local.research-asset-hub",
  "build": {
    "beforeBuildCommand": "pnpm --filter @research-asset-hub/web build",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "研究资产库",
        "url": "loading.html",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../stage/app": "app",
      "../stage/runtime": "runtime"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
