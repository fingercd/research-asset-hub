{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-asset-hub.local/schemas/paper-code-approvals.schema.json",
  "title": "Reviewed paper code decisions",
  "type": "object",
  "required": ["schema_version", "repositories", "no_code"],
  "properties": {
    "schema_version": {"const": "paper-code-approvals/v1"},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "official",
          "commit",
          "destination",
          "papers",
          "evidence"
        ],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "official": {"const": true},
          "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "destination": {"type": "string", "minLength": 1},
          "papers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["paper_id", "exact_title"],
              "properties": {
                "paper_id": {"type": "string", "minLength": 1},
                "exact_title": {"type": "string", "minLength": 1},
                "research_exact_title": {"type": "string", "minLength": 1},
                "paper_record_title": {"type": "string", "minLength": 1},
                "research_paper_record_title": {"type": "string", "minLength": 1},
                "runtime_title_binding": {"const": "exact_current_record"},
                "title_match": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "normalized_exact",
                    "paper_record_truncated_prefix",
                    "paper_record_truncated_long_common_prefix",
                    "paper_record_artifact_prefix",
                    "paper_record_truncated_long_overlap",
                    "agent_reviewed_exact_title_override"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "sparse_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "licenses": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "paper_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "paper_id",
                "research_status",
                "reviewed_at",
                "evidence_urls",
                "evidence_reason"
              ],
              "properties": {
                "paper_id": {"type": "string", "minLength": 1},
                "research_status": {"const": "official_public"},
                "reviewed_at": {"type": "string", "minLength": 1},
                "license": {"type": ["string", "null"]},
                "source_batch": {"type": "string", "minLength": 1},
                "source_line": {"type": "integer", "minimum": 1},
                "original_official_url": {"type": "string", "format": "uri"},
                "tree_ref": {"type": ["string", "null"]},
                "sparse_path": {"type": ["string", "null"]},
                "evidence_urls": {
                  "type": "array",
                  "items": {"type": "string", "format": "uri"}
                },
                "evidence_reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "no_code": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id",
          "exact_title",
          "verified_no_public_code",
          "reviewed_at",
          "evidence_urls"
        ],
        "properties": {
          "paper_id": {"type": "string", "minLength": 1},
          "exact_title": {"type": "string", "minLength": 1},
          "research_exact_title": {"type": "string", "minLength": 1},
          "paper_record_title": {"type": "string", "minLength": 1},
          "research_paper_record_title": {"type": "string", "minLength": 1},
          "runtime_title_binding": {"const": "exact_current_record"},
          "title_match": {
            "type": "string",
            "enum": [
              "exact",
              "normalized_exact",
              "paper_record_truncated_prefix",
              "paper_record_truncated_long_common_prefix",
              "paper_record_artifact_prefix",
              "paper_record_truncated_long_overlap",
              "agent_reviewed_exact_title_override"
            ]
          },
          "verified_no_public_code": {"const": true},
          "reviewed_at": {"type": "string", "minLength": 1},
          "research_status": {
            "type": "string",
            "enum": ["announced_pending", "none_found", "third_party_only"]
          },
          "announced_url": {"type": ["string", "null"], "format": "uri"},
          "announced_commit": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "license": {"type": ["string", "null"]},
          "evidence_reason": {"type": "string", "minLength": 1},
          "source_batch": {"type": "string", "minLength": 1},
          "source_line": {"type": "integer", "minimum": 1},
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"}
          }
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
