{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-asset-hub.local/schemas/paper-intake-routing-decisions-v1.json",
  "title": "Explicit paper intake routing decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {
      "const": "paper-intake-routing-decisions/v1"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "source_sha256", "target_domain", "evidence"],
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_domain": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
