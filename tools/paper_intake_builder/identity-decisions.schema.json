{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-asset-hub.local/schemas/paper-intake-identity-decisions-v1.json",
  "title": "Explicit paper intake alternate-version identity decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {
      "const": "paper-intake-identity-decisions/v1"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_sha256",
          "existing_vlm_id",
          "decision",
          "version_label",
          "target_relative_path"
        ],
        "properties": {
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "existing_vlm_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "const": "same_identity_alternate_version"
          },
          "version_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "target_relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+\\.pdf$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
