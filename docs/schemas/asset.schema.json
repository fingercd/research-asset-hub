{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-asset-hub.local/schemas/asset-v1.json",
  "title": "Research Asset Hub normalized asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "asset_type",
    "title"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "asset_type": {
      "oneOf": [
        {
          "enum": [
            "paper",
            "repository",
            "dataset",
            "method",
            "benchmark",
            "html_document",
            "note",
            "collection"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z][a-z0-9_-]{0,31}$"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_zh": {
      "type": [
        "string",
        "null"
      ]
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1450,
      "maximum": 2200
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis": {
      "type": "object",
      "default": {}
    },
    "visibility": {
      "enum": [
        "private",
        "internal",
        "public"
      ],
      "default": "private"
    },
    "external_identifiers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/external_identifier"
      }
    },
    "source_urls": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "domain_slugs": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
      }
    },
    "tags": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "default": {}
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    }
  },
  "$defs": {
    "external_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
