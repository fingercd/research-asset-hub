# Research Asset Hub 环境变量示例。
# 本文件是变量参考，不是自动加载配置；真实 .env 不要提交。
# Python ApiSettings 和 scripts/hub.ps1 读取进程环境，不自动读取 .env。
# PowerShell 示例：$env:HUB_API_PORT = '18767'
# 产品已退役独立网站/Compose；不要用旧 Web 环境变量启动第二套后端。
# 完整隔离开发步骤见 docs/DEVELOPMENT.md。
# 全部变量与默认值见 apps/api/config.py（前缀 HUB_），仅列常用项。

# 资产网关签名密钥：至少 32 字符。生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
HUB_GATEWAY_SECRET=

# 数据库连接（默认 postgresql://research_hub:research_hub_local@127.0.0.1:5432/research_asset_hub）
# HUB_DATABASE_URL=

# 最低要求的数据库迁移修订（>= 语义，默认与 migrations 最新 head 一致）
# HUB_DATABASE_REQUIRED_REVISION=0007_catalog_visibility_index

# 对外资产网关地址（分享场景需改为公网可达地址）
# HUB_GATEWAY_ORIGIN=http://127.0.0.1:8766

# 代码符号索引（默认关闭；置 true 启用 tree-sitter 符号抽取）
# HUB_WORKER_TREE_SITTER_ENABLED=false
